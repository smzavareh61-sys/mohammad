{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mohammad",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "fe659e50-68cd-4ee1-902d-f9c0a11ee9d5","database_name": "nova-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "49b6deb0f505450aa8b45d60427e2f96" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
